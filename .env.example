# ClipForge AI — copy to .env and adjust. Never commit real secrets.
APP_NAME=ClipForge AI
APP_TAGLINE=Turn long videos into your best short clips automatically.

# Server
CORS_ORIGINS=*

# Database: SQLite default. Production example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/clipforge
# A PaaS URL works verbatim — postgres://user:pass@host:5432/db?sslmode=require
# is normalized to postgresql+psycopg2:// on load (app/config.py).
DATABASE_URL=

# Built SPA served by the API (single-image deploys). Empty = auto-detect
# frontend/dist next to the repo root; the Dockerfile sets this to
# /app/frontend/dist. Point it at a copy of `npm run build` output to serve the
# UI and API from one process/port.
FRONTEND_DIST=

# Queue (optional — in-process pool is used when disabled)
REDIS_URL=
USE_REDIS_QUEUE=false
WORKER_CONCURRENCY=2

# Storage (local default; s3 provider = integration point)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=

# Limits
MAX_UPLOAD_SIZE=2147483648
MAX_VIDEO_DURATION=10800
MIN_VIDEO_DURATION=5
ALLOWED_EXTENSIONS=mp4,mov,webm,mkv,m4v

# FFmpeg (auto-detected when empty; imageio-ffmpeg bundled binary works too)
FFMPEG_PATH=
FFMPEG_THREADS=0

# Analysis
TRANSCRIPT_ENABLED=true
TRANSCRIPT_MODEL=tiny

# Clips
DEFAULT_NUM_CLIPS=10
MAX_NUM_CLIPS=20
DEFAULT_CLIP_DURATION=30
MIN_CLIP_DURATION=5
MAX_CLIP_DURATION=180
EVENT_MERGE_GAP=6
OVERLAP_THRESHOLD=0.5

# Engagement weights (JSON, auto-normalized)
SCORING_WEIGHTS={"audio_energy":0.20,"speech_activity":0.15,"scene_changes":0.15,"motion_intensity":0.15,"face_activity":0.10,"silence_break":0.10,"visual_change":0.10,"transcript_signal":0.05}

# Retention / privacy
CLEANUP_TEMP_FILES=true
RETENTION_DAYS=30

# Rate limit (non-GET requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# Frontend (Vite): leave empty for same-origin / dev-proxy setups
VITE_API_URL=
