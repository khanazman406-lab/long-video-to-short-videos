# Keep the Docker build context small and reproducible.
.git
.github
.env
.env.*
!.env.example
*.md
LICENSE
docker-compose.yml
render.yaml
railway.json

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/pytest_cache/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
backend/data/
backend/tests/.tmp/
*.db
*.db-journal

# Node / build output (the image rebuilds it in stage 1)
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/

# OS / editors
.DS_Store
*.swp
.vscode/
.idea/
