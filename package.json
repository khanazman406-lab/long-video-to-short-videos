{
  "name": "clipforge-ai",
  "version": "1.0.0",
  "description": "ClipForge AI — Turn long videos into your best short clips automatically.",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "client": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "install:all": "cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && cd ../frontend && npm install",
    "test": "cd backend && .venv/bin/python -m pytest tests/ -x -q"
  },
  "keywords": [
    "video",
    "ai",
    "short-videos",
    "tiktok",
    "instagram-reels",
    "youtube-shorts",
    "clipforge"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
